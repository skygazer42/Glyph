  "ddl": {
    "sqlite": [
      "\nCREATE TABLE dbconnection (\n\tid INTEGER NOT NULL, \n\tname VARCHAR(255) NOT NULL, \n\tdb_type VARCHAR(50) NOT NULL, \n\thost VARCHAR(255) NOT NULL, \n\tport INTEGER NOT NULL, \n\tusername VARCHAR(255) NOT NULL, \n\tpassword_encrypted VARCHAR(255) NOT NULL, \n\tdatabase_name VARCHAR(255) NOT NULL, \n\tcreated_at DATETIME DEFAULT CURRENT_TIMESTAMP, \n\tupdated_at DATETIME, \n\tPRIMARY KEY (id)\n)\n\n",
      "CREATE INDEX ix_dbconnection_id ON dbconnection (id)",
      "CREATE UNIQUE INDEX ix_dbconnection_name ON dbconnection (name)",
      "\nCREATE TABLE chatsession (\n\tid VARCHAR(255) NOT NULL, \n\ttitle VARCHAR(500) NOT NULL, \n\tconnection_id INTEGER, \n\tcreated_at DATETIME DEFAULT CURRENT_TIMESTAMP, \n\tupdated_at DATETIME, \n\tis_active BOOLEAN, \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(connection_id) REFERENCES dbconnection (id) ON DELETE SET NULL\n)\n\n",
      "CREATE INDEX ix_chatsession_connection_id ON chatsession (connection_id)",
      "CREATE INDEX ix_chatsession_id ON chatsession (id)",
      "\nCREATE TABLE schematable (\n\tid INTEGER NOT NULL, \n\tconnection_id INTEGER NOT NULL, \n\ttable_name VARCHAR(255) NOT NULL, \n\tdescription TEXT, \n\tui_metadata JSON, \n\tcreated_at DATETIME DEFAULT CURRENT_TIMESTAMP, \n\tupdated_at DATETIME, \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(connection_id) REFERENCES dbconnection (id)\n)\n\n",
      "CREATE INDEX ix_schematable_connection_id ON schematable (connection_id)",
