rule_id: {{ rule_id | tojson }}
name: {{ name | tojson }}
version: {{ version | tojson }}

policy_source:
  doc_id: {{ policy_source.doc_id | default(none) | tojson }}
  title: {{ policy_source.title | tojson }}
  {% if policy_source.clause %}clause: {{ policy_source.clause | tojson }}{% endif %}

# ===== 有效期 =====
valid_period: {{ valid_period | tojson }}

# ===== 输入参数 =====
inputs:
  - name: price
    type: float
    required: true
    description: "商品销售价格(>=0)"
  - name: energy_level
    type: integer   # 允许 1/2 或 null；null 代表无标识
    required: false
    description: "能效等级(1级/2级/无→null)"
  - name: category
    type: string
    required: true
    description: "家电类别"

# ===== 能效补贴率 =====
efficiency_rates: {{ efficiency_rates | tojson }}

# ===== 类别限额（数量或金额，需按政策决定生效点）=====
category_limits:
  per_category:
{% for category, limit in category_limits.per_category.items() %}
    {{ category | tojson }}: {{ limit | tojson }}
{% endfor %}
  total_items: {{ category_limits.total_items | default(none) | tojson }}

# ===== 单品补贴上限 =====
per_item_cap: {{ per_item_cap }}

# ===== 计算逻辑 =====
calc:
  result: "dsl_helpers.appliance_subsidy(inputs, efficiency_rates, per_item_cap, category_limits, rule.get('special_rules', {}), user_state)"

# ===== 特殊规则 =====
special_rules: {{ special_rules | tojson }}

# ===== 输出配置 =====
output:
  status: "{{ '{{' }} calc.result.status {{ '}}' }}"
  final_result: "{{ '{{' }} calc.result.final_subsidy {{ '}}' }}"
  trace_template: |
    - 商品价格：¥{{ '{{' }} calc.result.price {{ '}}' }}
    - 能效等级：{{ '{{' }} ('无' if calc.result.energy_level in (None, 0) else (str(calc.result.energy_level) + '级')) {{ '}}' }}
    - 补贴比例：{{ '{{' }} (calc.result.rate * 100) {{ '}}' }}%
    - 原始补贴：¥{{ '{{' }} calc.result.raw_subsidy {{ '}}' }}
    - 封顶后补贴：¥{{ '{{' }} calc.result.final_subsidy {{ '}}' }}
