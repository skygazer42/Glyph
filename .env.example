# 常用配置（40 项）；未列出的选项沿用代码默认值。
# 复制为 .env 后填写模型密钥、数据库密码和工作人员登录信息。
# 视觉、MinerU、联网和重排按需开启；目录与省略项说明见 docs/PROJECT_STRUCTURE.md。

# 对话模型
# 对话模型服务密钥（必填，支持 OpenAI 兼容服务）
LLM_API_KEY=
# 对话模型接口地址（硅基流动可填 https://api.siliconflow.cn/v1）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 对话模型名称，须与所选服务提供的模型一致
LLM_MODEL_NAME=qwen-max
# 单次模型请求超时时间（秒）
LLM_TIMEOUT=120

# 向量模型：只需填写所选后端对应的密钥和地址
# 向量服务类型：dashscope 或 openai（硅基流动选 openai）
EMBEDDING_BACKEND=dashscope
# OpenAI 兼容向量服务密钥（使用该后端时必填）
EMBEDDING_OPENAI_API_KEY=
# OpenAI 兼容向量接口地址（硅基流动填 https://api.siliconflow.cn/v1）
EMBEDDING_OPENAI_BASE_URL=
# OpenAI 兼容向量模型名（硅基流动可填 BAAI/bge-m3）
EMBEDDING_OPENAI_MODEL=text-embedding-3-small
# 阿里云百炼向量服务密钥（使用 dashscope 后端时必填）
EMBEDDING_DASHSCOPE_API_KEY=
# 阿里云百炼向量模型名称
EMBEDDING_DASHSCOPE_MODEL=text-embedding-v4
# 向量维度，须匹配模型和已有 Milvus 集合；示例百炼模型及 bge-m3 为 1024
EMBEDDING_DIM=1024

# 图片与票据识别
# 是否启用视觉识别（启用前填写下面的模型配置）
VISION__ENABLED=false
# 支持图片输入的视觉模型名称
VISION__MODEL=qwen-vl-max
# 视觉模型服务密钥
VISION__API_KEY=
# 视觉模型 OpenAI 兼容接口地址
VISION__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MySQL
# MySQL 主机地址（本机运行应用时使用 localhost）
DATABASE__MYSQL_HOST=localhost
# MySQL 端口（开发 Compose 将容器 3306 映射到本机 3307）
DATABASE__MYSQL_PORT=3307
# MySQL 登录用户名
DATABASE__MYSQL_USER=glyph
# MySQL 登录密码，须与数据库实际配置一致
DATABASE__MYSQL_PASSWORD=
# 应用使用的 MySQL 数据库名
DATABASE__MYSQL_DB=policy_db

# Milvus
# Milvus 向量数据库主机地址
DATABASE__MILVUS_HOST=localhost
# Milvus 服务端口；默认数据库为 default、集合为 policy_documents
DATABASE__MILVUS_PORT=19530

# 工作人员登录
# 工作人员登录账号（部署前填写）
SECURITY__API_DEFAULT_USERNAME=
# 工作人员登录密码（部署前设置强密码）
SECURITY__API_DEFAULT_PASSWORD=
# 登录令牌签名密钥（部署前生成足够长的随机字符串）
SECURITY__JWT_SECRET_KEY=
# 工作人员登录令牌有效期（分钟）
SECURITY__JWT_ACCESS_TOKEN_EXP_MINUTES=60
# 是否仅通过 HTTPS 发送认证 Cookie（HTTPS 部署时设为 true）
SECURITY__AUTH_COOKIE_SECURE=false

# 文档解析
# 是否启用 MinerU；默认自动选择模式，无密钥时使用本地 localhost:30001
MINERU_ENABLED=false
# MinerU 官方云服务密钥；留空时使用本地解析服务
MINERU_API_KEY=

# 文档切块策略（semantic 语义、sentence 句子、fixed 固定长度）；大小默认 1000、重叠默认 200
LLAMAINDEX_CHUNK_STRATEGY=semantic

# 检索与重排
# 是否启用分级索引与向量混合检索（需预先构建分级索引）
SYSTEM__HYBRID_RETRIEVAL_ENABLED=false
# 是否启用知识库结果重排（默认使用 DashScope 的 gte-rerank-v2）
KB_RERANK_ENABLED=false
# DashScope 重排服务密钥（启用重排时填写）
DASHSCOPE_API_KEY=

# 对话编排
# 是否启用 AgentChat Team 主处理链
AGENTCHAT_TEAM_ENABLED=true
# 是否启用 AgentChat Router 处理链（Team 未启用或失败时使用）
AGENTCHAT_ENABLED=true
# 是否启用模型流式输出（需要模型服务支持）
AGENTCHAT_STREAM_ENABLED=false
# 是否对工具执行结果生成自然语言答复
AGENTCHAT_REFLECT=true

# 联网兜底
# 是否启用联网搜索兜底（启用前填写 Tavily 密钥）
WEB_SEARCH__ENABLED=false
# Tavily 联网搜索服务密钥
WEB_SEARCH__TAVILY_API_KEY=

# 单个上传文件大小上限（MB）
DOCUMENT__MAX_FILE_SIZE_MB=50

# 常州业务图谱；可选重排须在配置有效服务凭据后开启。
LIGHTRAG_WORKDIR=resources/data/lightrag_changzhou_20261121
LIGHTRAG_RERANK_ENABLED=false
